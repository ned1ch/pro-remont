        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n&#39; Включаем режим отрисовки стрелок строго под прямым углом\nskinparam linetype ortho\n\n|Менеджер|\nstart\n:Выбрать рабочую операцию;\n\nif (Выбор операции) then ([Обработка и Назначение])\n    :Выбрать действие \&quot;Просматривать список заявок\&quot;;\n    :Запросить список всех заказов в БД;\n    :Настроить фильтр по статусу \&quot;Новая\&quot;;\n    if (Доступ к базе данных) then ([Сбой связи])\n        :Вывести ошибку \&quot;Не удалось загрузить данные\&quot;;\n        detach\n    else ([ОК])\n        :Отобразить отфильтрованную таблицу;\n        :Выбрать новую заявку;\n        :Выбрать действие \&quot;Принять в работу\&quot;;\n        if (Проверка записи) then ([Уже занята])\n            :Вывести ошибку \&quot;Заявка уже обрабатывается другим\&quot;;\n            detach\n        else ([Свободна])\n            :Изменить статус заявки на \&quot;В обработке\&quot;;\n            :Выбрать действие \&quot;Назначить мастера\&quot;;\n            if (Проверка занятости) then ([Все заняты])\n                :Вывести полный список сотрудников сервиса;\n            else ([Есть свободные])\n                :Вывести список доступных мастеров;\n            endif\n            :Выбрать сотрудника и нажать \&quot;Подтвердить выбор\&quot;;\n            :Закрепить мастера и отправить ему уведомление;\n        endif\n    endif\n\nelseif ([Изменение цен]) then\n    :Выбрать действие \&quot;Изменять цены на услуги\&quot;;\n    :Отобразить интерфейс прайс-листа;\n    :Найти нужную услугу и ввести стоимость;\n    :Нажать кнопку \&quot;Обновить прайс\&quot;;\n    if (Валидация цены) then ([Некорректно])\n        :Вывести сообщение об ошибке валидации цены;\n        detach\n    else ([Число &gt; 0])\n        :Сохранить новые цены в базе данных;\n        :Мгновенно обновить информацию на сайте;\n    endif\n\nelseif ([Прием оплаты]) then\n    :Выбрать заказ в статусе \&quot;Выполнен\&quot;;\n    :Выбрать действие \&quot;Оплатить заказ\&quot;;\n    :Сформировать счет и сгенерировать QR-код;\n    :Принять денежные средства и зафиксировать;\n    :Нажать \&quot;Проверить статус платежа\&quot;;\n    if (Кассовый шлюз) then ([Сбой])\n        :Сообщить, что платеж отклонен банком;\n    else ([Успешно])\n        :Изменить статус заявки на \&quot;Закрыта/Оплачена\&quot;;\n        :Сформировать и распечатать фискальный чек;\n    endif\nendif\n\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="iPCoQ2warEUr65ragz7l-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
