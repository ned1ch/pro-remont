  <diagram id="mJ6fQ5SpnYLnw34zFFD2" name="клиент">
    <mxGraphModel dx="2049" dy="1148" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n&#39; Включаем режим отрисовки стрелок строго под прямым углом\nskinparam linetype ortho\n\n|Клиент|\nstart\n:Выбрать действие в личном кабинете;\n\nif (Параметры выбора) then ([Редактировать профиль])\n    :Отобразить текущие данные профиля;\n    :Изменить контактную информацию;\n    :Нажать кнопку \&quot;Сохранить изменения\&quot;;\n    if (Валидация данных) then ([Данные верны])\n        :Обновить запись в базе данных;\n        :Вывести сообщение об успешном сохранении;\n    else ([Ошибка маски])\n        :Подсветить поле и вывести ошибку формата;\n        detach\n    endif\n\nelseif ([Получить спец.предложения]) then\n    :Проверить историю заказов клиента;\n    if (История заказов) then ([Существует])\n        :Сгенерировать акции на основе истории;\n    else ([Новый клиент])\n        :Сгенерировать стандартные приветственные акции;\n    endif\n    :Вывести список предложений на экран;\n\nelseif ([Оформить заявку]) then\n    :Отобразить форму создания заявки;\n    :Ввести ФИО, телефон, адрес и модель техники;\n    if (Проверка телефона) then ([Ошибка формата])\n        :Вывести ошибку маски номера телефона;\n        detach\n    else ([OK])\n        :Временно сохранить реквизиты в сессию;\n        :Описать неисправность и нажать \&quot;Отправить\&quot;;\n        :Сохранить заявку в БД (Статус новая);\n        :Выбрать действие \&quot;Оплатить заказ\&quot;;\n        :Сформировать итоговый счет;\n        :Выбрать способ платежа и подтвердить;\n        if (Банковский ответ) then ([Одобрено])\n            :Изменить статус оплаты на \&quot;Оплачено\&quot;;\n            :Вывести электронный чек на экран;\n        else ([Отклонено])\n            :Сообщить об отказе банка (нет средств);\n        endif\n    endif\n\nelseif ([Посмотреть статус ремонта]) then\n    :Проверить наличие заявок в БД;\n    if (Список ремонтов) then ([Заявок нет])\n        :Сообщение: \&quot;У вас пока нет оформленных заявок\&quot;;\n    else ([Есть заявки])\n        :Вывести список всех текущих ремонтов;\n        :Выбрать конкретный ремонт для просмотра;\n        :Отобразить полную информацию по заявке;\n        if (Проверка статуса) then ([Готово к выдаче])\n            :Вывести модальное уведомление о готовности;\n            :Нажать кнопку \&quot;Прочитано\&quot;;\n            :Скрыть окно и открыть детали заявки;\n        else ([В работе])\n            :Оставить стандартное отображение статуса;\n        endif\n    endif\nendif\n\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="dmOWR-hf0SZmj49aP-gw-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
