  <diagram id="hM_SPItLkMGrahqoI-5R" name="Администратор">
    <mxGraphModel dx="3535" dy="1980" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n&#39; Включаем режим отрисовки стрелок строго под прямым углом\nskinparam linetype ortho\n\n|Администратор|\nstart\n:Выбрать действие \&quot;Управлять пользователями и правами\&quot;;\n:Отобразить панель управления со списком сотрудников;\n\nif (Выбор административной функции) then ([Создать учетную запись])\n    :Открыть карточку регистрации сотрудника;\n    :Ввести ФИО, должность и рабочий e-mail;\n    :Нажать кнопку \&quot;Создать аккаунт\&quot;;\n    if (Проверка уникальности) then ([Email занят])\n        :Вывести ошибку \&quot;Email уже зарегистрирован в системе\&quot;;\n        detach\n    else ([Email свободен])\n        :Генерировать временный надежный пароль;\n        :Сохранить учетную запись сотрудника в БД;\n        :Вывести подтверждение создания аккаунта;\n    endif\n\nelseif ([Настроить права доступа]) then\n    :Выбрать сотрудника из списка;\n    :Выбрать действие \&quot;Настроить права доступа\&quot;;\n    :Открыть список чекбоксов разрешений;\n    :Изменить роли или отметить новые флаги;\n    :Нажать кнопку \&quot;Сохранить изменения\&quot;;\n    if (Проверка самоблокировки) then ([Снимает с себя])\n        :Вывести ошибку \&quot;Невозможно лишить себя прав\&quot;;\n    else ([Права другого юзера])\n        :Перезаписать конфигурацию прав в БД;\n        :Вывести подтверждение \&quot;Права успешно обновлены\&quot;;\n    endif\n\nelseif ([Удалить учетную запись]) then\n    :Выбрать сотрудника из списка;\n    :Нажать кнопку \&quot;Удалить учетную запись\&quot;;\n    :Вывести модальное окно с подтверждением;\n    :Нажать кнопку \&quot;Да, удалить\&quot;;\n    if (Системный уровень профиля) then ([Суперадминистратор])\n        :Запретить операцию и выдать ошибку;\n    else ([Обычный сотрудник])\n        :Удалить профиль из БД (или перевести в архив);\n        :Обновить список сотрудников на экране;\n    endif\n\nelseif ([Изменить CMS/дизайн]) then\n    :Выбрать действие \&quot;Переделать дизайн сайта\&quot;;\n    :Открыть constructor тем и редактор разделов;\n    :Загрузить элементы интерфейса и поменять блоки;\n    :Нажать кнопку \&quot;Опубликовать изменения\&quot;;\n    if (Процесс сборки) then ([Ошибка компиляции])\n        :Выполнить автоматический откат к стабильной версии;\n        :Вывести лог ошибки администратору;\n    else ([Успешно])\n        :Обновить файлы шаблонов и структуру на сервере;\n        :Вывести лог успешного деплоя;\n    endif\nendif\n\nstop\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="8o9ZGx3yBmfFKk37rqER-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlId="start_1" plantUmlBaseStyle="ellipse;fillColor=#222222;strokeColor=#222222;" plantUmlBaseValue="" id="8o9ZGx3yBmfFKk37rqER-2">
